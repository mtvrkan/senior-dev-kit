{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.envrc)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(./config/secrets.json)",
      "Read(./*.pem)",
      "Read(./*.key)",
      "Read(./*.p12)",
      "Read(./id_rsa)",
      "Read(./id_ed25519)",
      "Read(./.ssh/**)",
      "Read(./*firebase-adminsdk*.json)",
      "Read(./*serviceaccount*.json)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf .)",
      "Bash(rm -rf ./)",
      "Bash(rm -fr /)",
      "Bash(rm -fr /*)",
      "Bash(rm -fr ~)",
      "Bash(rm -fr ~/)",
      "Bash(rm -fr .)",
      "Bash(rm -fr ./)",
      "Bash(find . -delete)",
      "Bash(find / -delete)",
      "Bash(find ~ -delete)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git clean -fdx *)",
      "Bash(git reset --hard *)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Bash(chmod 000 *)",
      "Bash(chmod -R 000 *)",
      "Bash(chmod --recursive 777 *)",
      "Bash(chmod --recursive 000 *)",
      "Bash(sudo rm *)",
      "Bash(sudo chmod *)",
      "Bash(sudo chown *)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * -O- | bash)",
      "Bash(wget * -O- | sh)",
      "Bash(bash <(curl *)",
      "Bash(sh <(curl *)",
      "Bash(bash <(wget *)",
      "Bash(sh <(wget *)",
      "Bash(npx --yes *)",
      "Bash(npx -y *)",
      "Bash(pip install * --break-system-packages)",
      "Bash(pip install --break-system-packages *)",
      "Bash(pip3 install * --break-system-packages)",
      "Bash(pip3 install --break-system-packages *)"
    ]
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-haiku-4-5-20251001"
  }
}
