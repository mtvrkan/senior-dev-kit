{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    // check-consistency.ts imports the installer's pure core to validate
    // documented flags against the parser itself rather than a second list.
    // That module is plain ESM JavaScript on purpose (it has to run on a new
    // user's Node, not a contributor's) — allowJs lets tsc resolve it and infer
    // from its JSDoc without type-checking the file itself.
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["scripts/**/*.ts"]
}
